# Supabase — proyecto "ttg"
# Estos valores son públicos por diseño (van al bundle del navegador) y
# quedan protegidos por Row Level Security en la base de datos, no por
# mantenerlos en secreto. Cópialos desde Supabase Dashboard > Project
# Settings > API, o pídeselos a quien administra el proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional. Recomendado en producción (Vercel) para construir los links de
# los correos de auth (confirmación, recuperación) de forma confiable, sin
# depender del header Origin. Sin dominio final todavía, se puede omitir.
NEXT_PUBLIC_SITE_URL=

# Supabase — clave service_role (secreta, NUNCA va al bundle del navegador,
# NUNCA debe tener el prefijo NEXT_PUBLIC_). Hace bypass de RLS: la usa
# exclusivamente el webhook de Stripe (server-only) para confirmar pagos
# reales sin depender de la sesión del comprador. Cópiala desde Supabase
# Dashboard > Project Settings > API > Project API keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — claves secretas (server-only, jamás con prefijo NEXT_PUBLIC_).
# Dashboard > Developers > API keys. Usa las de modo test mientras no haya
# cuentas Connect reales verificadas.
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > (tu endpoint) > Signing secret.
# En local con `stripe listen`, usa el whsec_ que imprime la CLI (es distinto
# al de producción).
STRIPE_WEBHOOK_SECRET=

# Comisión de plataforma en puntos básicos (500 = 5%). Se aplica sobre el
# monto total de cada orden al crear la Checkout Session.
PLATFORM_FEE_BPS=500
